# Copy to deploy/.env on the server and fill in. Never commit the real file.
ENV=production
JWT_SECRET=__generate_with_openssl_rand_hex_32__
DB_PASSWORD=__strong_random__
COOKIE_SECURE=true
DEMO_MODE=1                 # 1 = show demo-role buttons on the login page (concept environment); 0 for a real pilot
SEED_PASSWORD=__demo_password__
SEED_HISTORY=1              # synthetic analytics history (concept environment only)
EVALUATION_ENGINE=auto      # auto | claude | rubric
ANTHROPIC_API_KEY=          # Claude: checkpoint concept extraction + grounded assistant
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low
FAL_KEY=                    # fal.ai: full-body lecturer video rendering
VIDEO_ENGINE=fal-ai/bytedance/omnihuman/v1.5
VIDEO_RESOLUTION=720p
WEB_BIND=127.0.0.1:8150
WORKERS=3
